flowchart TB
  subgraph K["Registering a rule: PutBucketLifecycle"]
    direction LR
    k1["key = tenant:bucket:marker<br/>(get_bucket_lc_key)"] --> k2["ceph_str_hash_linux(key)<br/>% 7877 % rgw_lc_max_objs"] --> k3["object lc.N in the log pool<br/>(N between 0 and 31)"] --> k4["bucket entry with state<br/>UNINITIAL in lc.N"]
  end
