  end
  subgraph O["For each object version"]
    direction LR
    o1["obj_has_expired(mtime, days)"] --> o2["Expiration ⇒ delete or a delete marker"] --> o3["Transition ⇒ copy to the target class's pool<br/>and update the manifest"] --> o4["end: COMPLETE"]
  end
  K --> W --> O
