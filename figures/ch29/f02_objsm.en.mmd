flowchart TB
  subgraph R1["rbd_img_state"]
    direction LR
    A["RBD_IMG_START"] --> B["RBD_IMG_EXCLUSIVE_LOCK<br/>(if the feature is enabled)"] --> C["RBD_IMG_OBJECT_REQUESTS<br/>(wait for all obj_reqs)"] --> D["complete the request in blk-mq"]
  end
  subgraph R2["rbd_obj_write_state"]
    direction LR
    E["START"] --> F["PRE_OBJECT_MAP<br/>(mark OBJECT_EXISTS)"] --> G["OBJECT<br/>(write to the OSD)"] --> H["COPYUP<br/>(-ENOENT in a clone)"] --> I["POST_OBJECT_MAP"]
  end
  subgraph R3["rbd_obj_read_state"]
    direction LR
    J["START"] --> K["READ_OBJECT"] --> L["READ_PARENT<br/>(if -ENOENT and it has a parent)"]
  end
  R1 ~~~ R2 ~~~ R3
