flowchart TB
  OSD["OSD: تراکنش RADOS"] --> BS["BlueStore"]
  BS -->|"داده"| ALLOC["Allocator<br/>فضای آزاد دستگاه block"]
  BS -->|"فراداده: onode، extent، omap"| RDB["RocksDB"]
