flowchart TB
  subgraph R1["Logical layer"]
    direction LR
    o["object: pool=3, name=rbd_data.5e2a.00…01"] --> h["hobject_t: hash=rjenkins(name)<br/>+ namespace + snap"] --> pg["pg_t = (pool, ceph_stable_mod(hash, pg_num))<br/>e.g. 3.1a"]
  end
  subgraph R2["Mapping layer (OSDMap)"]
    direction LR
    cr["CRUSH(pps, rule) → [osd.4, osd.9, osd.17]"] --> up["up set ← upmap / pg_temp / primary_temp<br/>→ acting set"] --> pr["primary = acting[0]<br/>(primary affinity applies)"]
  end
  subgraph R3["Physical layer (on each OSD)"]
    direction LR
    bs["BlueStore collection 3.1a_head"] --> on["onode in RocksDB (prefix O)<br/>nid, size, attrs, extent_map_shards"] --> bl["extent → blob → pextent<br/>(offset/length on the raw disk)"]
  end
  R1 ~~~ R2 ~~~ R3
