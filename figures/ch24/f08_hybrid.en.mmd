flowchart TB
  subgraph I["Inserting a free range: AvlAllocator::_try_insert_range"]
    direction LR
    i1["free range [start, end)"] --> i2{"number of ranges below range_count_cap?<br/>cap = hybrid_alloc_mem_cap / sizeof(range_seg_t)"}
    i2 -- "yes" --> i3["insert into the two AVL trees<br/>(offset-based and size-based)"]
    i2 -- "no" --> i4{"larger than the tree's smallest range?"}
    i4 -- "yes" --> i5["insert and move the smallest range<br/>to bitmap (_spillover_range)"]
    i4 -- "no" --> i6["straight to bitmap"]
  end
  subgraph A["Allocation: HybridAllocatorBase::allocate"]
    direction LR
    a1["want, unit, max_alloc_size"] --> a2{"bitmap not empty and<br/>want below the smallest AVL range?"}
    a2 -- "yes" --> a3["bitmap first"]
    a2 -- "no" --> a4["AVL first"]
    a3 --> a5["shortfall from the other;<br/>if none: ENOSPC"]
    a4 --> a5
  end
  I ~~~ A
