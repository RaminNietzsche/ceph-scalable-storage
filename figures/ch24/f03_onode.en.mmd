flowchart TB
  subgraph R1["onode key (prefix O)"]
    direction LR
    K1["shard+0x80<br/>(u8)"] --> K2["pool+2^63<br/>(u64 BE)"] --> K3["hash<br/>bit-reversed (u32)"] --> K4["nspace!<br/>key ‹=› name!"] --> K5["snap, gen (u64)<br/>+ 'o'"]
  end
  subgraph R2["value: bluestore_onode_t"]
