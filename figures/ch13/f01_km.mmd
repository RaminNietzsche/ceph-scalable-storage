flowchart LR
  OBJ["شیء ۱۶ KiB<br/>(یک stripe با stripe_unit=4K و k=4)"] --> D0["shard 0: داده<br/>4K"]
  OBJ --> D1["shard 1: داده"]
  OBJ --> D2["shard 2: داده"]
  OBJ --> D3["shard 3: داده"]
  D0 & D1 & D2 & D3 --> ENC["encode<br/>ماتریس Reed-Solomon"]
  ENC --> P0["shard 4: parity"]
  ENC --> P1["shard 5: parity"]
