    k1["read the SQ tail"] --> k2["blk-mq: bio and request"] --> k3["NVMe completion and IRQ"] --> k4["write the CQE and advance the CQ tail"]
  end
  subgraph C["Reaping: the aio_thread in KernelDevice"]
    direction LR
    c1["get_next_completed<br/>cq_mutex lock"] --> c2["io_uring_for_each_cqe<br/>up to max = bdev_aio_reap_max (16), then cq_advance"] --> c3["if zero: epoll_wait on ring_fd<br/>with bdev_aio_poll_ms"] --> c4["aio_t.rval = cqe.res<br/>and call aio_callback"]
  end
  S --> K --> C
