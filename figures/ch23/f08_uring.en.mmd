flowchart TB
  subgraph S["Submission: aio_submit in KernelDevice"]
    direction LR
    s1["ioring_queue_t::submit_batch<br/>sq_mutex lock"] --> s2["for each aio_t:<br/>io_uring_get_sqe and init_sqe"] --> s3["prep_writev/readv<br/>IOSQE_FIXED_FILE"] --> s4["io_uring_submit<br/>(io_uring_enter or SQPOLL)"]
  end
  subgraph K["Kernel"]
