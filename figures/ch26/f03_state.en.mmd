flowchart TB
  subgraph R1["connect side"]
    direction LR
    A["START_CONNECT"] --> B["BANNER_CONNECTING"] --> C["HELLO_CONNECTING"] --> D["AUTH_CONNECTING<br/>AUTH_CONNECTING_SIGN"] --> E["COMPRESSION_CONNECTING"]
  end
  subgraph R2["Session"]
    direction LR
    F["SESSION_CONNECTING<br/>(new session)"] --> G["SESSION_RECONNECTING<br/>(previous cookie)"] --> H["READY"]
  end
  subgraph R3["Receiving a message in READY"]
    direction LR
    I["THROTTLE_MESSAGE<br/>(count)"] --> J["THROTTLE_BYTES<br/>(policy throttler)"] --> K["THROTTLE_DISPATCH_QUEUE<br/>(100M)"] --> L["THROTTLE_DONE<br/>READ_MESSAGE_COMPLETE"]
  end
  subgraph R4["Fault and close"]
    direction LR
    M["socket error"] --> N["lossless: STANDBY<br/>or reconnect with backoff"] --> O["lossy / mark_down:<br/>CLOSED"]
  end
  subgraph R5["accept side"]
    direction LR
    P["START_ACCEPT"] --> Q["BANNER_ACCEPTING"] --> R["HELLO_ACCEPTING"] --> S["AUTH_ACCEPTING(_MORE/_SIGN)"] --> T["COMPRESSION_ACCEPTING<br/>SESSION_ACCEPTING"]
  end
  R1 ~~~ R2 ~~~ R3 ~~~ R4 ~~~ R5
