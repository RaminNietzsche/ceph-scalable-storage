flowchart TB
  subgraph A["۱. شیء به PG (کلاینت، Objecter)"]
    direction LR
    o["نام شیء + namespace<br/>(یا locator key)"] --> h["ceph_str_hash<br/>(rjenkins پیش‌فرض)"] --> s["ceph_stable_mod(hash, pg_num, pg_num_mask)<br/>→ ps (seed)"]
  end
  subgraph B["۲. PG به OSD (CRUSH)"]
    direction LR
    p["raw_pg_to_pps:<br/>hash(ps, pool_id)"] --> c["crush_do_rule(rule, x=pps)<br/>take → choose/chooseleaf → emit"] --> r["raw up set<br/>[osd.4, osd.11, osd.19]"]
  end
  subgraph C["۳. پس‌پردازش (OSDMap)"]
    direction LR
    u["حذف OSDهای down/nonexistent"] --> m["اعمال pg_upmap / pg_upmap_items"] --> t["pg_temp و primary_temp<br/>→ acting set و primary"]
  end
  A ~~~ B ~~~ C
