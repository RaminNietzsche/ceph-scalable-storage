flowchart TB
  subgraph S1["1. Capacity of each CRUSH root"]
    direction LR
    A["number of OSDs in the root"] --> B["PG budget = OSDs × mon_target_pg_per_osd<br/>(Squid/Tentacle: 100, Umbrella: 200)"]
  end
  subgraph S2["2. Each pool's share"]
    direction LR
    C["capacity_ratio from actual usage<br/>or target_size_ratio / target_size_bytes"] --> D["pg_target = share × budget × bias / size"] --> E["bulk: full share from the start<br/>non-bulk: the minimum needed"]
  end
  subgraph S3["3. Rounding and decision"]
    direction LR
    F["round to a power of 2<br/>(Umbrella: knapsack optimization)"] --> G{"difference from current pg_num<br/>more than threshold (3)?"}
    G -- yes --> H["set pg_num_target<br/>gradual split/merge"]
    G -- no --> I["no change<br/>(prevents oscillation)"]
  end
  S1 ~~~ S2 ~~~ S3
