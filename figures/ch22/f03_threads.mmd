  end
  subgraph R3["کمکی"]
    direction LR
    fin["Finisher: اجرای callbackها<br/>در thread جدا (on_commit و ...)"] --- tm["SafeTimer: رویدادهای زمان‌دار<br/>(tick، heartbeat)"] --- kvt["BlueStore: kv_sync_thread<br/>+ kv_finalize_thread"]
  end
