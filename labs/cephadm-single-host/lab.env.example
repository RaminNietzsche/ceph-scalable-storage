# Copy to lab.env and edit. Every script reads this file.
# Ceph release whose cephadm build is downloaded (see https://docs.ceph.com/en/latest/releases/).
CEPH_RELEASE=tentacle
# The IP address of this VM on the network the cluster will use.
MON_IP=192.0.2.10
# Three empty disks for OSDs. Everything on them is destroyed.
LAB_DISKS="/dev/vdb /dev/vdc /dev/vdd"
# Short host name as cephadm will register it (defaults to hostname -s).
# LAB_HOST=ceph-lab
